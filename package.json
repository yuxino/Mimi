{
  "name": "mimi",
  "private": true,
  "version": "1.6.5",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "dev:app": "bash scripts/dev-app.sh --watch",
    "dev:ui": "bash scripts/dev-app.sh --watch --ui-only",
    "typecheck": "tsc -b",
    "build:dev": "vite build --config config/vite.config.ts --mode development --minify false --sourcemap",
    "build": "npm run icons:verify && tsc -b && vite build --config config/vite.config.ts && node scripts/check-production-debugger.mjs",
    "preview": "vite preview --config config/vite.config.ts",
    "lint": "eslint --config config/eslint.config.js . --cache --cache-strategy content --cache-location node_modules/.cache/eslint",
    "test": "vitest --config config/vite.config.ts run --maxWorkers=2",
    "test:watch": "vitest --config config/vite.config.ts --maxWorkers=2",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "icons:generate": "node scripts/app-icons.mjs generate",
    "icons:verify": "node scripts/app-icons.mjs verify"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  },
  "author": "yuxino <nbsawz@gmail.com>"
}
